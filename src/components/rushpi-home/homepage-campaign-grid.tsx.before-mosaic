import { ArrowRight } from "lucide-react";
import Link from "next/link";
import type { CSSProperties, ReactNode } from "react";

import type { HomepageCampaign } from "@/types/homepage-campaign";

type HomepageCampaignGridProps = {
  campaigns: HomepageCampaign[];
};

const sizeClasses = {
  large: "min-h-[320px] md:col-span-8 md:row-span-2 md:min-h-0",
  medium: "min-h-[280px] md:col-span-6 md:min-h-0",
  small: "min-h-[260px] md:col-span-4 md:min-h-0",
} as const;

function CampaignLink({
  campaign,
  className,
  children,
}: {
  campaign: HomepageCampaign;
  className: string;
  children: ReactNode;
}) {
  const url = campaign.destination_url;

  if (!url) {
    return <article className={className}>{children}</article>;
  }

  if (url.startsWith("http://") || url.startsWith("https://")) {
    return (
      <a
        href={url}
        className={className}
        target="_blank"
        rel="noreferrer"
        aria-label={campaign.title}
      >
        {children}
      </a>
    );
  }

  return (
    <Link href={url} className={className} aria-label={campaign.title}>
      {children}
    </Link>
  );
}

function CampaignCard({
  campaign,
  onlyCampaign,
}: {
  campaign: HomepageCampaign;
  onlyCampaign: boolean;
}) {
  const cardStyle = {
    backgroundColor: campaign.background_color,
    color: campaign.text_color,
  } satisfies CSSProperties;

  const className = [
    "group relative overflow-hidden rounded-[1.75rem]",
    "isolate shadow-sm ring-1 ring-black/5",
    "transition duration-300 hover:-translate-y-1",
    "hover:shadow-xl focus-visible:outline-none",
    "focus-visible:ring-2 focus-visible:ring-blue-600",
    onlyCampaign
      ? "min-h-[320px] md:col-span-12 md:min-h-[390px]"
      : sizeClasses[campaign.card_size],
  ].join(" ");

  return (
    <CampaignLink campaign={campaign} className={className}>
      <div className="absolute inset-0" style={cardStyle} />

      <picture>
        {campaign.mobile_image_url ? (
          <source
            media="(max-width: 639px)"
            srcSet={campaign.mobile_image_url}
          />
        ) : null}

        {/* eslint-disable-next-line @next/next/no-img-element */}
        <img
          src={campaign.desktop_image_url}
          alt=""
          className="absolute inset-0 size-full object-cover transition duration-700 group-hover:scale-[1.03]"
        />
      </picture>

      <div className="absolute inset-0 bg-gradient-to-r from-black/70 via-black/30 to-transparent" />

      <div className="relative flex h-full min-h-[inherit] max-w-xl flex-col justify-end p-6 text-white sm:p-8">
        <p className="text-xs font-black uppercase tracking-[0.2em] text-white/75">
          Featured on RushPi
        </p>

        <h2 className="mt-3 text-3xl font-black leading-none tracking-[-0.04em] sm:text-4xl">
          {campaign.title}
        </h2>

        {campaign.subtitle ? (
          <p className="mt-3 max-w-md text-sm leading-6 text-white/85 sm:text-base">
            {campaign.subtitle}
          </p>
        ) : null}

        {campaign.destination_url ? (
          <span className="mt-6 inline-flex w-fit items-center gap-2 rounded-full bg-white px-5 py-2.5 text-sm font-black text-slate-950 transition group-hover:bg-blue-600 group-hover:text-white">
            {campaign.button_text || "Shop now"}
            <ArrowRight className="size-4 transition group-hover:translate-x-1" />
          </span>
        ) : null}
      </div>
    </CampaignLink>
  );
}

export default function HomepageCampaignGrid({
  campaigns,
}: HomepageCampaignGridProps) {
  if (campaigns.length === 0) {
    return null;
  }

  const orderedCampaigns = [...campaigns].sort(
    (first, second) => first.position - second.position,
  );

  return (
    <section
      className="mx-auto w-full max-w-[1500px] px-4 py-8 sm:px-6 lg:px-8"
      aria-label="Homepage promotions"
    >
      <div className="mb-5 flex items-end justify-between gap-4">
        <div>
          <p className="text-xs font-black uppercase tracking-[0.18em] text-blue-600">
            Special highlights
          </p>

          <h2 className="mt-1 text-2xl font-black tracking-[-0.03em] text-slate-950 sm:text-3xl">
            Explore what&apos;s new
          </h2>
        </div>
      </div>

      <div className="grid auto-rows-[260px] grid-cols-1 gap-4 md:grid-cols-12 md:grid-flow-dense">
        {orderedCampaigns.map((campaign) => (
          <CampaignCard
            key={campaign.public_id}
            campaign={campaign}
            onlyCampaign={orderedCampaigns.length === 1}
          />
        ))}
      </div>
    </section>
  );
}
